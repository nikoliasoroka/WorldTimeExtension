{
  "manifest_version": 3,
  "name": "World Time",
  "version": "1.0.0",
  "description": "Track multiple world timezones at a glance",
  "action": {
    "default_popup": "popup.html",
    "default_title": "World Time"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
